{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🔤 تمييز الأحرف الصوتية\n",
    "\n",
    "تحليل وتصنيف الأحرف الصوتية\n",
    "\n",
    "**تم التطوير بمساعدة Perplexity AI**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from mouthlocnet import PhonemeClassifier\n",
    "\n",
    "print('✅ المكتبات جاهزة')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1️⃣ محاكاة مواقع الأحرف"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# مواقع الأحرف المتوقعة (متر)\n",
    "phoneme_positions = {\n",
    'ب': np.array([0.0, 0.0, 0.050]),\n",
    'م': np.array([0.0, 0.0, 0.048]),\n",
    'س': np.array([0.0, 0.0, 0.040]),\n",
    'ش': np.array([0.0, 0.0, 0.038]),\n",
    'ت': np.array([0.0, 0.0, 0.035]),\n",
    'د': np.array([0.0, 0.0, 0.035]),\n",
    'ك': np.array([0.0, 0.0, 0.030]),\n",
    'ج': np.array([0.0, 0.0, 0.030]),\n",
    'ع': np.array([0.0, 0.0, 0.025]),\n",
    'ح': np.array([0.0, 0.0, 0.025]),\n",
    "}\n",
    "\n",
    "print('✅ تم إنشاء مواقع الأحرف')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2️⃣ تحميل المصنف"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "classifier = PhonemeClassifier.from_pretrained('models/phoneme_classifier.pt', num_phonemes=10)\n",
    "print(f'✅ تم تحميل المصنف')\n",
    "print(f'✅ الأحرف: {classifier.phoneme_labels}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3️⃣ اختبار التصنيف"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('=' * 70)\n",
    "print('📊 نتائج تصنيف الأحرف')\n",
    "print('=' * 70)\n",
    "\n",
    "correct = 0\n",
    "total = len(phoneme_positions)\n",
    "\n",
    "for phoneme, pos in phoneme_positions.items():\n",
    "    # إضافة ضوضاء\n",
    "    noisy_pos = pos + np.random.randn(3) * 0.001\n",
    "    \n",
    "    result = classifier.predict(noisy_pos)\n",
    "    is_correct = result.phoneme == phoneme\n",
    "    \n",
    "    if is_correct:\n",
    "        correct += 1\n",
    "    \n",
    "    status = '✅' if is_correct else '❌'\n",
    "    print(f'{status} {phoneme}: predicted = {result.phoneme} (confidence = {result.confidence:.2f})')\n",
    "\n",
    "accuracy = correct / total * 100\n",
    "print('=' * 70)\n",
    "print(f'✅ الدقة: {accuracy:.1f}% ({correct}/{total})')\n",
    "print('=' * 70)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4️⃣ تصور النتائج"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig = plt.figure(figsize=(10, 8))\n",
    "ax = fig.add_subplot(111, projection='3d')\n",
    "\n",
    "for phoneme, pos in phoneme_positions.items():\n",
    "    ax.scatter(pos[0]*1000, pos[1]*1000, pos[2]*1000, s=100, label=phoneme)\n",
    "\n",
    "ax.set_xlabel('X (mm)')\n",
    "ax.set_ylabel('Y (mm)')\n",
    "ax.set_zlabel('Z (mm)')\n",
    "ax.set_title('مواقع الأحرف الصوتية')\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('phoneme_positions.png', dpi=150, bbox_inches='tight')\n",
    "print('✅ Saved: phoneme_positions.png')\n",
    "plt.show()"
   ]
  }
 ],
